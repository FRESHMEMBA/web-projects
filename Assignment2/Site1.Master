<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site1.master.cs" Inherits="Assignment2.Site1" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title>
        <asp:ContentPlaceHolder ID="Tab" runat="server">
        </asp:ContentPlaceHolder>
    </title>
    <link href="StyleSheet1.css" rel="stylesheet" type="text/css"/>

</head>
<body>
    <form id="form1" runat="server">
        <header>
            <asp:ContentPlaceHolder ID="Heading" runat="server">
            </asp:ContentPlaceHolder>
        </header>
        <div id="page">
            <nav>
                <asp:Menu ID="NavMenu" Orientation="Horizontal" runat="server">
                    <Items>
                        <asp:MenuItem NavigateUrl="~/Home.aspx" Text="Home" Value="Home"></asp:MenuItem>
                        <asp:MenuItem NavigateUrl="~/Register.aspx" Text="Register" Value="Register"></asp:MenuItem>
                        <asp:MenuItem NavigateUrl="~/Login.aspx" Text="Login" Value="Login"></asp:MenuItem>
                        <asp:MenuItem NavigateUrl="~/Logout.aspx" Text="Logout" Value="Logout"></asp:MenuItem>
                    </Items>
                </asp:Menu>
            </nav>
            <main>
                <section id="main-left">
                    <asp:ContentPlaceHolder ID="MainLeft" runat="server">

                    </asp:ContentPlaceHolder>
                </section>
                <section id="main-right">
                    <asp:ContentPlaceHolder ID="MainRight" runat="server">

                    </asp:ContentPlaceHolder>
                </section>
            </main>
        </div>
        <footer>
            <p>Created by Sibonelo - August 2026</p>
            <asp:SiteMapPath ID="FooterContent" runat="server">

            </asp:SiteMapPath>
        </footer>
    </form>
</body>
</html>
